# Web
VITE_API_URL=http://127.0.0.1:3001

# Desktop OAuth/live Registry API. Public Beta builds must point this at the
# deployed HTTPS API; localhost is only for development.
VITE_HARNESSHUB_API_URL=http://127.0.0.1:3001

# Optional data-only control plane. HTTPS is required outside loopback.
VITE_HARNESSHUB_REMOTE_CONFIG_URL=

# API
API_HOST=127.0.0.1
API_PORT=3001
API_RATE_LIMIT=120
API_RATE_LIMIT_TTL_MS=60000
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost

# GitHub-only OAuth. Put real values in .env; never commit that file.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:3001/auth/github/callback
SESSION_SECRET=
AUTH_WEB_SUCCESS_URL=http://127.0.0.1:5173/?auth=success
OAUTH_TRANSACTION_TTL_SECONDS=600
SESSION_TTL_SECONDS=604800
DEVELOPER_CLAIM_TTL_SECONDS=86400

# PostgreSQL (local development helper defaults)
DATABASE_URL=postgresql://harnesshub@127.0.0.1:54329/harnesshub?schema=public

# Optional: raises GitHub API limits for the manual Registry sync.
GITHUB_TOKEN=

# Optional server-only token for public plugin discovery. If empty, the API
# reuses the server-only GITHUB_TOKEN above. Never expose either token in
# Desktop/Web variables. Anonymous discovery uses a smaller detail budget.
GITHUB_DISCOVERY_TOKEN=
DISCOVERY_RESULTS_PER_QUERY=30
DISCOVERY_DETAIL_LIMIT=12
# 0 disables background sync. Set 15 or higher when a production API is ready.
DISCOVERY_SYNC_INTERVAL_MINUTES=0
