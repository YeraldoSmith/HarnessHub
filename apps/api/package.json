{
  "name": "@harnesshub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "predev": "pnpm prisma:generate",
    "dev": "node --watch --import tsx src/main.ts",
    "prebuild": "pnpm prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "pretypecheck": "pnpm prisma:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "preregistry:sync": "pnpm prisma:generate",
    "registry:sync": "tsx src/sync-registry.ts"
  },
  "dependencies": {
    "@harnesshub/plugin-schema": "workspace:*",
    "@harnesshub/plugin-sources": "workspace:*",
    "@harnesshub/types": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.2.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "prisma": "^7.9.1",
    "tsx": "^4.20.6",
    "vitest": "^4.1.11"
  }
}
