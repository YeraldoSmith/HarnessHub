generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  GITHUB
  NPM
  GITHUB_NPM
}

enum SourceProvider {
  GITHUB
  NPM
}

enum SourceAvailability {
  UNKNOWN
  AVAILABLE
  UNAVAILABLE
}

enum CandidatePluginStatus {
  COLLECTED_UNVERIFIED
}

enum PluginRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  DELETED
}

enum IdentityProvider {
  GITHUB
}

enum PlatformRole {
  FOUNDER
  ADMIN
  MODERATOR
  REVIEWER
  DEVELOPER
  USER
}

enum IdentityBadge {
  FOUNDER
  OFFICIAL
  VERIFIED_DEVELOPER
  MODERATOR
  REVIEWER
  EARLY_USER
  BETA_TESTER
}

enum AssignmentScope {
  PLATFORM
  PLUGIN
}

enum OAuthClient {
  WEB
  DESKTOP
}

enum OAuthTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DeveloperVerificationStatus {
  UNVERIFIED
  VERIFIED
  RESTRICTED
}

enum DeveloperClaimStatus {
  PENDING
  VERIFYING
  APPROVED
  REJECTED
  CONFLICT
  EXPIRED
  CANCELLED
}

enum OwnershipType {
  OWNER
  MAINTAINER
  TEAM_MEMBER
  ORGANIZATION_DELEGATE
}

enum VerificationMethod {
  GITHUB_REPOSITORY_CHALLENGE
}

enum SourceOwnerType {
  USER
  ORGANIZATION
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  publicId         BigInt            @unique @default(autoincrement()) @map("public_id")
  status           UserStatus        @default(ACTIVE)
  securityVersion  Int               @default(1) @map("security_version")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  suspendedAt      DateTime?         @map("suspended_at") @db.Timestamptz(3)
  deactivatedAt    DateTime?         @map("deactivated_at") @db.Timestamptz(3)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(3)
  identities       OAuthIdentity[]
  roleAssignments  RoleAssignment[]
  badgeGrants      BadgeGrant[]
  sessions         AuthSession[]
  developerProfile DeveloperProfile?
  developerClaims  DeveloperClaim[]
  pluginOwnerships PluginOwnership[]

  @@map("users")
}

model OAuthIdentity {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  provider            IdentityProvider
  issuer              String           @db.VarChar(255)
  providerUserId      String           @map("provider_user_id") @db.VarChar(255)
  metadata            Json
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastAuthenticatedAt DateTime?        @map("last_authenticated_at") @db.Timestamptz(3)
  disabledAt          DateTime?        @map("disabled_at") @db.Timestamptz(3)
  user                User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  developerClaims     DeveloperClaim[]

  @@unique([provider, issuer, providerUserId])
  @@index([userId])
  @@map("oauth_identities")
}

model RoleAssignment {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  role            PlatformRole
  scopeType       AssignmentScope @default(PLATFORM) @map("scope_type")
  scopeId         String?         @map("scope_id") @db.VarChar(120)
  grantedByUserId String?         @map("granted_by_user_id") @db.Uuid
  reason          String          @db.VarChar(255)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime?       @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime?       @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId String?         @map("revoked_by_user_id") @db.Uuid
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, role])
  @@map("role_assignments")
}

model BadgeGrant {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  badge           IdentityBadge
  grantedByUserId String?       @map("granted_by_user_id") @db.Uuid
  evidenceType    String        @map("evidence_type") @db.VarChar(80)
  evidenceRef     String?       @map("evidence_ref") @db.VarChar(255)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime?     @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(3)
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, badge])
  @@map("user_badge_grants")
}

model OAuthTransaction {
  id                       String                 @id @default(uuid()) @db.Uuid
  stateHash                String                 @unique @map("state_hash") @db.Char(64)
  codeVerifierCiphertext   String?                @map("code_verifier_ciphertext") @db.Text
  client                   OAuthClient
  status                   OAuthTransactionStatus @default(PENDING)
  desktopPollTokenHash     String?                @map("desktop_poll_token_hash") @db.Char(64)
  desktopSessionCiphertext String?                @map("desktop_session_ciphertext") @db.Text
  errorCode                String?                @map("error_code") @db.VarChar(80)
  expiresAt                DateTime               @map("expires_at") @db.Timestamptz(3)
  consumedAt               DateTime?              @map("consumed_at") @db.Timestamptz(3)
  completedAt              DateTime?              @map("completed_at") @db.Timestamptz(3)
  deliveredAt              DateTime?              @map("delivered_at") @db.Timestamptz(3)
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, expiresAt])
  @@map("oauth_transactions")
}

model AuthSession {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  tokenHash  String      @unique @map("token_hash") @db.Char(64)
  client     OAuthClient
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt  DateTime?   @map("revoked_at") @db.Timestamptz(3)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  targetType  String   @map("target_type") @db.VarChar(80)
  targetId    String?  @map("target_id") @db.VarChar(255)
  metadata    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_events")
}

model Plugin {
  id              String            @id @db.VarChar(120)
  name            String            @db.VarChar(120)
  description     String            @db.Text
  category        String            @db.VarChar(80)
  authorName      String            @map("author_name") @db.VarChar(120)
  authorHandle    String            @map("author_handle") @db.VarChar(120)
  tags            String[]          @default([])
  license         String            @db.VarChar(80)
  sourceType      SourceType        @map("source_type")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  sources         PluginSource[]
  versions        PluginVersion[]
  developerClaims DeveloperClaim[]
  ownerships      PluginOwnership[]

  @@map("plugins")
}

model DeveloperProfile {
  id                 String                      @id @default(uuid()) @db.Uuid
  userId             String                      @unique @map("user_id") @db.Uuid
  displayName        String                      @map("display_name") @db.VarChar(80)
  bio                String?                     @db.VarChar(500)
  website            String?                     @db.VarChar(500)
  verificationStatus DeveloperVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?                   @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("developer_profiles")
}

model DeveloperClaim {
  id                    String                 @id @default(uuid()) @db.Uuid
  pluginId              String                 @map("plugin_id") @db.VarChar(120)
  claimantUserId        String                 @map("claimant_user_id") @db.Uuid
  oauthIdentityId       String                 @map("oauth_identity_id") @db.Uuid
  provider              IdentityProvider       @default(GITHUB)
  sourceExternalId      String                 @map("source_external_id") @db.VarChar(255)
  sourceOwnerType       SourceOwnerType        @map("source_owner_type")
  sourceOwnerExternalId String                 @map("source_owner_external_id") @db.VarChar(255)
  repositoryUrl         String                 @map("repository_url") @db.VarChar(500)
  sourceRef             String                 @map("source_ref") @db.VarChar(255)
  status                DeveloperClaimStatus   @default(PENDING)
  proofType             VerificationMethod     @map("proof_type")
  challengeHash         String                 @map("challenge_hash") @db.Char(64)
  challengePath         String                 @map("challenge_path") @db.VarChar(255)
  challengeExpiresAt    DateTime               @map("challenge_expires_at") @db.Timestamptz(3)
  verifiedAt            DateTime?              @map("verified_at") @db.Timestamptz(3)
  resolvedAt            DateTime?              @map("resolved_at") @db.Timestamptz(3)
  errorCode             String?                @map("error_code") @db.VarChar(80)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  plugin                Plugin                 @relation(fields: [pluginId], references: [id], onDelete: Restrict)
  claimant              User                   @relation(fields: [claimantUserId], references: [id], onDelete: Restrict)
  oauthIdentity         OAuthIdentity          @relation(fields: [oauthIdentityId], references: [id], onDelete: Restrict)
  evidence              VerificationEvidence[]
  ownership             PluginOwnership?

  @@index([pluginId, status])
  @@index([claimantUserId, createdAt(sort: Desc)])
  @@map("developer_claims")
}

model PluginOwnership {
  id                    String             @id @default(uuid()) @db.Uuid
  pluginId              String             @map("plugin_id") @db.VarChar(120)
  userId                String             @map("user_id") @db.Uuid
  developerClaimId      String             @unique @map("developer_claim_id") @db.Uuid
  ownershipType         OwnershipType      @default(OWNER) @map("ownership_type")
  verificationMethod    VerificationMethod @map("verification_method")
  sourceExternalId      String             @map("source_external_id") @db.VarChar(255)
  sourceOwnerType       SourceOwnerType    @map("source_owner_type")
  sourceOwnerExternalId String             @map("source_owner_external_id") @db.VarChar(255)
  verifiedAt            DateTime           @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt             DateTime?          @map("revoked_at") @db.Timestamptz(3)
  plugin                Plugin             @relation(fields: [pluginId], references: [id], onDelete: Restrict)
  user                  User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  developerClaim        DeveloperClaim     @relation(fields: [developerClaimId], references: [id], onDelete: Restrict)

  @@index([userId, verifiedAt(sort: Desc)])
  @@index([pluginId, ownershipType])
  @@map("plugin_ownerships")
}

model VerificationEvidence {
  id                    String             @id @default(uuid()) @db.Uuid
  developerClaimId      String             @map("developer_claim_id") @db.Uuid
  provider              IdentityProvider
  evidenceType          VerificationMethod @map("evidence_type")
  sourceExternalId      String             @map("source_external_id") @db.VarChar(255)
  sourceOwnerType       SourceOwnerType    @map("source_owner_type")
  sourceOwnerExternalId String             @map("source_owner_external_id") @db.VarChar(255)
  repositoryUrl         String             @map("repository_url") @db.VarChar(500)
  commitSha             String             @map("commit_sha") @db.VarChar(40)
  payload               Json
  observedAt            DateTime           @map("observed_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  developerClaim        DeveloperClaim     @relation(fields: [developerClaimId], references: [id], onDelete: Restrict)

  @@index([developerClaimId, observedAt(sort: Desc)])
  @@index([sourceExternalId])
  @@map("verification_evidence")
}

model PluginSource {
  id               String             @id @default(cuid()) @db.VarChar(40)
  pluginId         String             @map("plugin_id") @db.VarChar(120)
  provider         SourceProvider
  repositoryUrl    String?            @map("repository_url") @db.Text
  packageName      String?            @map("package_name") @db.VarChar(214)
  evidence         Json
  status           SourceAvailability @default(UNKNOWN)
  lastVerifiedAt   DateTime?          @map("last_verified_at") @db.Timestamptz(3)
  unavailableSince DateTime?          @map("unavailable_since") @db.Timestamptz(3)
  lastError        String?            @map("last_error") @db.VarChar(500)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  plugin           Plugin             @relation(fields: [pluginId], references: [id], onDelete: Restrict)

  @@unique([pluginId, provider])
  @@index([provider])
  @@map("plugin_sources")
}

model SyncJob {
  id         String        @id @default(cuid()) @db.VarChar(40)
  pluginId   String        @map("plugin_id") @db.VarChar(120)
  source     String        @db.VarChar(40)
  status     SyncJobStatus @default(PENDING)
  startedAt  DateTime?     @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?     @map("finished_at") @db.Timestamptz(3)
  error      String?       @db.Text
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([pluginId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("sync_jobs")
}

model PluginVersion {
  id            String           @id @default(cuid()) @db.VarChar(40)
  pluginId      String           @map("plugin_id") @db.VarChar(120)
  version       String           @db.VarChar(80)
  sourceCommit  String?          @map("source_commit") @db.VarChar(40)
  npmVersion    String?          @map("npm_version") @db.VarChar(80)
  compatibility Json
  identityKey   String           @unique @map("identity_key") @db.VarChar(64)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  plugin        Plugin           @relation(fields: [pluginId], references: [id], onDelete: Restrict)
  snapshots     PluginSnapshot[]

  @@index([pluginId, createdAt(sort: Desc)])
  @@map("plugin_versions")
}

model PluginSnapshot {
  id              String        @id @default(cuid()) @db.VarChar(40)
  pluginVersionId String        @map("plugin_version_id") @db.VarChar(40)
  checkedAt       DateTime      @map("checked_at") @db.Timestamptz(3)
  source          String        @db.VarChar(40)
  data            Json
  evidence        Json
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  pluginVersion   PluginVersion @relation(fields: [pluginVersionId], references: [id], onDelete: Restrict)

  @@index([pluginVersionId, checkedAt(sort: Desc)])
  @@map("plugin_snapshots")
}

model CandidatePlugin {
  id                String                @id @default(cuid()) @db.VarChar(40)
  provider          SourceProvider        @default(GITHUB)
  externalId        String                @map("external_id") @db.VarChar(255)
  canonicalKey      String                @unique @map("canonical_key") @db.VarChar(255)
  repository        String                @db.VarChar(255)
  repositoryUrl     String                @map("repository_url") @db.VarChar(500)
  owner             String                @db.VarChar(120)
  name              String                @db.VarChar(120)
  description       String                @db.Text
  defaultBranch     String                @map("default_branch") @db.VarChar(255)
  readmeExcerpt     String?               @map("readme_excerpt") @db.Text
  licenseSpdx       String?               @map("license_spdx") @db.VarChar(80)
  stars             Int                   @default(0)
  upstreamUpdatedAt DateTime              @map("upstream_updated_at") @db.Timestamptz(3)
  commitSha         String?               @map("commit_sha") @db.VarChar(40)
  packageName       String?               @map("package_name") @db.VarChar(214)
  packageVersion    String?               @map("package_version") @db.VarChar(80)
  packageIntegrity  String?               @map("package_integrity") @db.VarChar(300)
  dshCompatibility  String?               @map("dsh_compatibility") @db.VarChar(80)
  category          String                @default("Other") @db.VarChar(40)
  permissions       Json
  riskLevel         PluginRiskLevel       @default(HIGH) @map("risk_level")
  riskReasons       Json                  @map("risk_reasons")
  riskAssessedAt    DateTime              @map("risk_assessed_at") @db.Timestamptz(3)
  riskModelVersion  String                @map("risk_model_version") @db.VarChar(40)
  metadataSha256    String                @map("metadata_sha256") @db.Char(64)
  sourceMetadata    Json                  @map("source_metadata")
  status            CandidatePluginStatus @default(COLLECTED_UNVERIFIED)
  active            Boolean               @default(true)
  retryCount        Int                   @default(0) @map("retry_count")
  lastError         String?               @map("last_error") @db.VarChar(500)
  discoveredAt      DateTime              @map("discovered_at") @db.Timestamptz(3)
  lastObservedAt    DateTime              @map("last_observed_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  snapshots         CandidatePluginSnapshot[]

  @@index([active, status, upstreamUpdatedAt(sort: Desc)])
  @@index([owner, name])
  @@map("candidate_plugins")
}

model CandidatePluginSnapshot {
  id                String          @id @default(cuid()) @db.VarChar(40)
  candidatePluginId String          @map("candidate_plugin_id") @db.VarChar(40)
  metadataSha256    String          @map("metadata_sha256") @db.Char(64)
  category          String          @db.VarChar(40)
  riskLevel         PluginRiskLevel @map("risk_level")
  riskReasons       Json            @map("risk_reasons")
  permissions       Json
  sourceMetadata    Json            @map("source_metadata")
  evidence          Json
  observedAt        DateTime        @map("observed_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  candidatePlugin   CandidatePlugin @relation(fields: [candidatePluginId], references: [id], onDelete: Restrict)

  @@unique([candidatePluginId, metadataSha256])
  @@index([candidatePluginId, observedAt(sort: Desc)])
  @@map("candidate_plugin_snapshots")
}
