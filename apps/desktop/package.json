{
  "name": "@harnesshub/desktop",
  "version": "0.7.3-beta.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm --filter @harnesshub/types build && pnpm --filter @harnesshub/plugin-schema build && pnpm --filter @harnesshub/i18n build && pnpm --filter @harnesshub/plugin-sources build && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@harnesshub/i18n": "workspace:*",
    "@harnesshub/installation-prototype": "workspace:*",
    "@harnesshub/plugin-schema": "workspace:*",
    "@harnesshub/plugin-sources": "workspace:*",
    "@harnesshub/runtime-bridge": "workspace:*",
    "@harnesshub/runtime-integration": "workspace:*",
    "@harnesshub/types": "workspace:*",
    "@harnesshub/ui": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
