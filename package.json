{
  "name": "harnesshub",
  "version": "0.7.3-beta.1",
  "private": true,
  "description": "Community Marketplace for AI Agent Plugins",
  "author": "YeraldoSmith",
  "copyright": "Copyright © 2026 YeraldoSmith",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter @harnesshub/types --filter @harnesshub/i18n --filter @harnesshub/plugin-schema --filter @harnesshub/plugin-sources --filter @harnesshub/ui --filter @harnesshub/installation-prototype --filter @harnesshub/runtime-integration --filter @harnesshub/runtime-bridge -r build",
    "dev": "pnpm build:packages && pnpm --parallel --filter @harnesshub/api --filter @harnesshub/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @harnesshub/api dev",
    "dev:web": "pnpm build:packages && pnpm --filter @harnesshub/web dev",
    "dev:desktop": "pnpm build:packages && pnpm --filter @harnesshub/desktop tauri:dev",
    "db:generate": "pnpm --filter @harnesshub/api prisma:generate",
    "db:migrate": "pnpm --filter @harnesshub/api db:migrate",
    "db:local:start": "bash scripts/postgres-local.sh start",
    "db:local:stop": "bash scripts/postgres-local.sh stop",
    "registry:sync": "pnpm build:packages && pnpm --filter @harnesshub/api registry:sync",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm build:packages && pnpm -r --if-present test",
    "test:integration": "bash scripts/test-postgres-integration.sh",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
