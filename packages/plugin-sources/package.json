{
  "name": "@harnesshub/plugin-sources",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@harnesshub/plugin-schema": "workspace:*",
    "@harnesshub/types": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
